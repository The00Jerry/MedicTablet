# ---- Secrets (NIEMALS committen) ----
# Kopiere diese Datei zu .env und trage echte Werte ein.

# MySQL (dieselbe DB wie das FiveM-Script!)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=medic_panel
DB_PASSWORD=change_me
DB_NAME=fivem

# Discord OAuth2 (aus https://discord.com/developers/applications)
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=change_me

# Sitzungs-/JWT-Signaturschluessel (zufaellig, lang!)
JWT_SECRET=bitte_langen_zufallswert_eintragen

# Optional: Port ueberschreiben (sonst aus config.json)
# PORT=8080

# Optional: Pfad zur config.json (Standard: ./config.json)
# CONFIG_PATH=./config.json
